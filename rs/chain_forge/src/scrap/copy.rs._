
pub type Pulse = f32;


struct Shape {
    pub frames: usize,
    pub channels: usize,
}

struct Signal {
    data: Vec<Pulse>,
    shape: Shape,
}


impl Signal {
    
    fn produce<U impl ParallelUnOp>(&self) -> Self {
        Self {
            shape: self.shape,
            self.data.iter().map(U::produce).collect()
        }
    }

    fn mutate<U impl ParallelUnOp>(&mut self) {
        self.data.iter_mut().for_each(U::mutate)
    }
}

enum Alignment {
    SameSize,
    Repeat1st,
    Repeat2nd,
    Project1st,
    Project2nd,
}

impl Alignment {
    fn of(a: &Shape, b: &Shape) -> Option<Self> {
        if a.frames == b.frames {
            if a.channels == b.channels {
                Some(Alignment::SameSize)
            } else if a.channels % b.channels == 0 {
                Some(Alignment::Repeat2nd)
            } else if b.channels % a.channels == 0 {
                Some(Alignment::Repeat1st)
            } else {
                None
            }
        } else if a.frames == 1 {
            if a.channels == 1 {
                Some(Alignment::Repeat1st)
            } else if ... {
                Some(Alignment::Project1st)
            } else {
                None
            }

        } else if b.frames == 1 && b.channels == 1{
            Some(Alignment::Repeat2nd)
        } else {
            None
        }
    }
}

