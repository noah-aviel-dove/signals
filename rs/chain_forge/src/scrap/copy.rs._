pub trait GenOp {
    fn produce(ctx: &Context) -> Signal;
}


pub trait ParallelUnOp {
    fn produce(x: Pulse) -> Pulse;

    fn mutate(x: &mut Pulse) {
        *x = produce(*x);
    }
}


pub struct Sine;

impl ParallelUnOp for Sine {
    fn produce(x: Pulse) {
        x.sin()
    }
}


pub trait ParallelBinOp {
    fn produce(x: Pulse, y: Pulse) -> Pulse;

    fn mutate(x: &mut Pulse, y: Pulse) -> Pulse {
        *x = produce(*x, y);
    }
}


pub trait SerialBinOp {
    fn produce(x: &[Pulse], y: &[Pulse]) -> Vec<Pulse>;

    // Not sure whether mutate would ever make sense
}


pub struct Conv;

impl SerialBinOp for Conv {
    fn produce(x: &[Pulse], y: &[Pulse]) -> Vec<Pulse> {
        // got lost here
    }
} 


pub struct Add;

impl ParallelBinOp for Add {
    fn produce(x: Pulse, y: Pulse) -> Pulse {
        x + y
    }
}

pub struct Mul;

impl ParallelBinOp for Add {
    fn produce(x: Pulse, y: Pulse) -> Pulse {
        x * y
    }
}


pub struct Clock;


impl GenOp for Clock {
    fn produce(ctx: &Context) -> Signal {
        Matrix (
            (ctx.offset..(ctx.offset + ctx.shape.frames)).map(Pulse::from).collect(),
            ctx.shape.channels,
        )
    }
}


fn exec_parallel_binop<B impl ParallelBinOp> (x: &Signal, y: &Signal) -> Option<Signal> {
    if x.channels == y.channels && x.data.len()
}


enum Link {
    BinOp([SignalSource; 2]),
}


enum SignalSource {
    Stack (usize),
    Vars (String),
}

struct Chain {
    id: i32,
    stack: Vec<Signal>,
    vars: HashMap<String, Signal>,
    links: Vec<Link>,
}

