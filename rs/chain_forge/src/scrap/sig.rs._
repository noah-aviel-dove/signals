
pub type Scalar = f32;

pub struct Column {
    data: Vec<Scalar>,
}

pub struct Matrix {
    data: Vec<Scalar>,
    channels: usize,
}

pub enum Signal {
    S(Scalar),
    C(Column),
    M(Matrix), 
}

pub struct Shape {
    frames: usize,
    channels: usize,
}

pub struct Context {
    offset: usize,
    rate: usize,
    shape: Shape,
}


impl Shape {
    fn of(sig: &Signal) {
        match sig {
            Scalar(_) => Shape {frames: 1, channels: 1},
            Column(x) => Shape {frames: 1, channels: x.len()},
            Matrix(x, channels) => Shape {frames: x.len() / channels, channels: channels },
        }
    }

    fn size(&self) {
        self.channels * self.frames
    }
}


pub trait GenOp {
    fn produce(ctx: &Context) -> Signal;
}


pub trait ParallelUnOp {
    fn produce(x: Pulse) -> Pulse;

    fn mutate(x: &mut Pulse) {
        *x = produce(*x);
    }
}


pub struct Sine;

impl ParallelUnOp for Sine {
    fn produce(x: Pulse) {
        x.sin()
    }
}


pub trait ParallelBinOp {
    fn produce(x: Pulse, y: Pulse) -> Pulse;

    fn mutate(x: &mut Pulse, y: Pulse) -> Pulse {
        *x = produce(*x, y);
    }
}


pub trait SerialBinOp {
    fn produce(x: &[Pulse], y: &[Pulse]) -> Vec<Pulse>;

    // Not sure whether mutate would ever make sense
}


pub struct Conv;

impl SerialBinOp for Conv {
    fn produce(x: &[Pulse], y: &[Pulse]) -> Vec<Pulse> {
        // got lost here
    }
} 


pub struct Add;

impl ParallelBinOp for Add {
    fn produce(x: Pulse, y: Pulse) -> Pulse {
        x + y
    }
}

pub struct Mul;

impl ParallelBinOp for Add {
    fn produce(x: Pulse, y: Pulse) -> Pulse {
        x * y
    }
}


pub struct Clock;


impl GenOp for Clock {
    fn produce(ctx: &Context) -> Signal {
        Matrix (
            (ctx.offset..(ctx.offset + ctx.shape.frames)).map(Pulse::from).collect(),
            ctx.shape.channels,
        )
    }
}


enum SignalSource {
    Stack (usize),
    Vars (String),
}




fn exec_parallel_binop<B impl ParallelBinOp> (x: &Signal, y: &Signal) -> Signal {
    match (x, y) {
        (Scalar(x), Scalar(y)    ) => Scalar(B::produce(x, y)),
        (Scalar(x), Column(y)    ) => Column(y.map(|y| {B::produce(x, y)}),
        (Scalar(x), Matrix(y, c) ) => Matrix(y.map(|y| {B::produce(x, y)}), c),
        (Column(x), Scalar(y)    ) => Column(x.map(|x| {B::produce(x, y)}),
        (Column(x), Column(y)    ) => {
            assert_eq!(x.len(), y.len());
            Column(x.iter().zip(y.iter()).map(|(x, y)| {B::produce(x, y)}))
        },
        (Column(x), Matrix(y, c)   ) => {
            assert_eq!(x.len(), c);
            // this is wrong, isn't it? iterates the column horizontally. this has to involve more
            // math.
            let f = y.len() / c;
            Matrix(x.iter().cycle().zip(y.iter()).map(|(x, y)| {B::produce(x, y)), c)
            // WIP. I think this is right? 
            Matrix(y.iter().zip(x.iter().flat_map(|x| repeat(x).take(f))).map(|(x, y)| {B::produce(x, y)}), c)
        },
        (Matrix(x, c), Scalar(y)   ) => Matrix(x.map(|x| {B::produce(x, y)},
        (Matrix(x, c), Column(y)   ) => {
            assert_eq!(c, y.len());
            Matrix(x.iter().zip(y.iter().cycle()).map(|(x, y)| {B::produce(x, y)}), c)
        },
        (Matrix(x, c), Matrix(y, d)) => {
            assert_eq!(x.len(), y.len());
            assert_eq!(c, d);
            Matrix(x.iter().zip(y.iter()).map(|(x, y)| {B::produce(x, y)}), c)
        }
    }
}

//==================================

struct Shape {
    pub frames: usize,
    pub channels: usize,
}

struct Signal<'a> {
    data: Vec<Pulse>,
    shape: Shape,
}


impl Signal {
    fn samp(&self, index: usize) -> Pulse {
        self.data[index]
    }
    
    fn csamp(&self, channel: usize, frame: usize) -> Pulse {
        self.data[channel * self.frames + frame]
    }

    fn shape(&self) -> Shape {
        self.shape
    }

    fn produce<U impl ParallelUnOp>(&self) -> Self {
        Self {
            shape: self.shape,
            self.data.iter().map(U::produce).collect()
        }
    }

    fn mutate<U impl ParallelUnOp>(&mut self) {
        self.data.iter_mut().for_each(U::mutate)
    }
}


fn exec_parallel_binop<B impl ParallelBinOp> (x: &Signal, y: &Signal) -> Option<Signal> {
    if x.channels == y.channels && x.data.len()
}


enum Link {
    BinOp([SignalSource; 2]),
}


struct Chain {
    id: i32,
    stack: Vec<Signal>,
    vars: HashMap<String, Signal>,
    links: Vec<Link>,
}

